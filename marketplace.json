{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "kartollikaa",
  "displayName": "kartollikaa's bb plugins",
  "description": "Plugins Dmitrii Maksimov builds for bb.",
  "plugins": [
    {
      "id": "inline-terminal",
      "displayName": "Inline Terminal",
      "description": "Adds a Run button to shell code blocks in agent replies, opens an interactive terminal under the block, and sends the result back to the chat.",
      "icon": {
        "url": "./icons/inline-terminal.svg"
      },
      "tags": [
        "terminal",
        "shell",
        "chat"
      ],
      "author": {
        "name": "Dmitrii Maksimov",
        "github": "kartollikaa"
      },
      "source": {
        "git": {
          "url": "https://github.com/kartollikaa/bb-plugins.git",
          "subdir": "plugins/inline-terminal",
          "range": "^0.1.0",
          "tagPrefix": "inline-terminal/"
        }
      }
    },
    {
      "id": "thread-tree",
      "displayName": "Thread Tree",
      "description": "A sidebar thread list that shows automations, recent activity and archived threads, nests child threads under their parent and shows each thread's provider subagents as a counter with a status dot.",
      "icon": {
        "url": "./icons/thread-tree.svg"
      },
      "tags": [
        "sidebar",
        "threads",
        "subagents"
      ],
      "author": {
        "name": "Dmitrii Maksimov",
        "github": "kartollikaa"
      },
      "source": {
        "git": {
          "url": "https://github.com/kartollikaa/bb-plugins.git",
          "subdir": "plugins/thread-tree",
          "range": "^0.2.0",
          "tagPrefix": "thread-tree/"
        }
      }
    },
    {
      "id": "github-folder",
      "displayName": "GitHub Folder",
      "description": "A sidebar folder of the open GitHub pull requests that need you: review requests, your PRs with changes requested, failing checks or conflicts, and the ones ready to merge.",
      "icon": {
        "url": "./icons/github-folder.svg"
      },
      "tags": [
        "github",
        "pull-requests",
        "sidebar"
      ],
      "author": {
        "name": "Dmitrii Maksimov",
        "github": "kartollikaa"
      },
      "source": {
        "git": {
          "url": "https://github.com/kartollikaa/bb-plugins.git",
          "subdir": "plugins/github-folder",
          "range": "^0.1.0",
          "tagPrefix": "github-folder/"
        }
      }
    },
    {
      "id": "reveal-in-finder",
      "displayName": "Reveal In Finder",
      "description": "Shows files an agent hands over as cards in chat, with Open in Finder, the default app or bb's preview.",
      "icon": {
        "url": "./icons/reveal-in-finder.svg"
      },
      "tags": [
        "files",
        "finder",
        "chat"
      ],
      "author": {
        "name": "Dmitrii Maksimov",
        "github": "kartollikaa"
      },
      "source": {
        "git": {
          "url": "https://github.com/kartollikaa/bb-plugins.git",
          "subdir": "plugins/reveal-in-finder",
          "range": "^0.1.0",
          "tagPrefix": "reveal-in-finder/"
        }
      }
    },
    {
      "id": "battery",
      "displayName": "Battery",
      "description": "Shows the laptop's battery charge in the sidebar footer, with a popup of each device's state and charge.",
      "icon": {
        "url": "./icons/battery.svg"
      },
      "tags": [
        "battery",
        "sidebar",
        "macos"
      ],
      "author": {
        "name": "Dmitrii Maksimov",
        "github": "kartollikaa"
      },
      "source": {
        "git": {
          "url": "https://github.com/kartollikaa/bb-plugins.git",
          "subdir": "plugins/battery",
          "range": "^0.1.0",
          "tagPrefix": "battery/"
        }
      }
    },
    {
      "id": "artifacts",
      "displayName": "Artifacts",
      "description": "Your published Claude Code artifacts and Codex Sites in one bb page, opened in bb's browser.",
      "icon": {
        "url": "./icons/artifacts.svg"
      },
      "tags": [
        "claude",
        "codex",
        "artifacts",
        "sites"
      ],
      "author": {
        "name": "Dmitrii Maksimov",
        "github": "kartollikaa"
      },
      "source": {
        "git": {
          "url": "https://github.com/kartollikaa/bb-plugins.git",
          "subdir": "plugins/artifacts",
          "range": "^0.1.0",
          "tagPrefix": "artifacts/"
        }
      }
    },
    {
      "id": "thread-switcher",
      "displayName": "Thread Switcher",
      "description": "Switch between recent threads with a hotkey (Control+Tab by default) and see a preview of each chat.",
      "icon": {
        "url": "./icons/thread-switcher.svg"
      },
      "tags": [
        "threads",
        "navigation",
        "keyboard",
        "shortcut"
      ],
      "author": {
        "name": "Dmitrii Maksimov",
        "github": "kartollikaa"
      },
      "source": {
        "git": {
          "url": "https://github.com/kartollikaa/bb-plugins.git",
          "subdir": "plugins/thread-switcher",
          "range": "^0.1.0",
          "tagPrefix": "thread-switcher/"
        }
      }
    }
  ]
}
